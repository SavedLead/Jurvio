# Store the real file only at /opt/jurvio/.env.production with mode 600.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://jurvio:URL_ENCODED_PASSWORD@postgres:5432/jurvio
SITE_URL=https://jurvio.com
COURTLISTENER_API_BASE_URL=https://www.courtlistener.com/api/rest/v4
COURTLISTENER_API_TOKEN=
INGESTION_USER_AGENT=Jurvio/0.1 (contact: legal@jurvio.com)
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUDIENCE=

# Encrypted off-Droplet database backups (nightly-db-backup.yml + verify-backup-restore.yml).
# The bucket MUST be separate from the raw-artifact bucket. Generate the key with
# `openssl rand -base64 32` and store it OUTSIDE this box as well -- a backup whose
# only key lives on the box it protects is not a recovery plan.
JURVIO_BACKUP_BUCKET=jurvio-db-backups
JURVIO_BACKUP_ENCRYPTION_KEY=
# Optional: default to the JURVIO_SPACES_* credentials/endpoint when unset.
JURVIO_BACKUP_ACCESS_KEY_ID=
JURVIO_BACKUP_SECRET_ACCESS_KEY=

# Customer email via Resend. Without RESEND_API_KEY and EMAIL_FROM, /signin shows
# "temporarily unavailable" and alert digests are skipped. EMAIL_FROM must use a
# domain verified in Resend, e.g. "Jurvio <alerts@mail.jurvio.com>".
# EMAIL_POSTAL_ADDRESS is the physical mailing address printed in digest footers.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_POSTAL_ADDRESS=

# Stripe (disabled while STRIPE_SECRET_KEY is empty: /pricing shows "Coming soon").
# Checkout for a plan needs STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET (endpoint
# https://jurvio.com/api/billing/webhook) and that plan's recurring price id.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
